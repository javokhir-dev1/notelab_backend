{
  "info": {
    "name": "NoteLab API",
    "_postman_id": "notelab-api-collection",
    "description": "NoteLab backend uchun barcha mavjud API endpointlar",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/notelab",
      "type": "string"
    },
    {
      "key": "userAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminAccessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "User Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"password\": \"secret123\",\n  \"avatar_url\": \"https://example.com/avatar.png\",\n  \"bio\": \"Hello, I am John\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/userauth/register",
              "host": ["{{baseUrl}}"],
              "path": ["userauth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "  pm.collectionVariables.set('userAccessToken', res.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/userauth/login",
              "host": ["{{baseUrl}}"],
              "path": ["userauth", "login"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/userauth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["userauth", "logout"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/userauth/1/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["userauth", "1", "refresh"]
            },
            "description": "URL dagi 1 o'rniga user ID kiriting"
          }
        }
      ]
    },
